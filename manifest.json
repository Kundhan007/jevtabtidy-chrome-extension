{
  "manifest_version": 3,
  "name": "Jevtabtidy",
  "version": "0.1.0",
  "description": "Every few minutes: group work tabs, collapse idle groups, sort groups A-Z, close forgotten tabs.",
  "minimum_chrome_version": "121",
  "permissions": ["tabs", "tabGroups", "alarms", "storage", "favicon"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "host_permissions": ["https://api.typesafe.ai/*"],
  "optional_host_permissions": ["https://*/*"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Jevtabtidy",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true }
}
